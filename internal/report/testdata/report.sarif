{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Helmbulance",
          "informationUri": "https://github.com/Git-Hospital/helmbulance",
          "rules": [
            {
              "id": "HB-UV-001",
              "shortDescription": {
                "text": "A Secret changes on an upgrade with no values"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "HB-K8S-003",
              "shortDescription": {
                "text": "The chart uses APIs that are deprecated or removed on Kubernetes 1.37"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "HB-K8S-004",
              "shortDescription": {
                "text": "The API server warns about objects this chart creates on Kubernetes 1.37"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "HB-SCAN-003",
              "shortDescription": {
                "text": "Candidate: Secret values are generated anew on every upgrade"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "HB-UV-001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "A Secret changes on an upgrade with no values\n\nClients lose their password."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "charts/app/Chart.yaml",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "partialFingerprints": {
            "helmbulance/v1": "12879a29c13a0882b2a91de4633601b0bc331200413fcc66aa0b115185224e88"
          },
          "properties": {
            "scenario": "upgrade-without-values",
            "severity": "high",
            "evidence": [
              "app/password changed"
            ],
            "fix": "Use lookup.",
            "reproduce": [
              "helm upgrade app ./charts/app"
            ]
          }
        },
        {
          "ruleId": "HB-K8S-003",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "The chart uses APIs that are deprecated or removed on Kubernetes 1.37"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "charts/app/Chart.yaml",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "partialFingerprints": {
            "helmbulance/v1": "8ae5878e72356310c4946128851fefb510c37233fe95b170bfac0147b92ad435"
          },
          "properties": {
            "scenario": "k8s-1.37",
            "severity": "medium",
            "evidence": [
              "policy/v1beta1 PodDisruptionBudget"
            ],
            "reproduce": []
          }
        },
        {
          "ruleId": "HB-K8S-003",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "The chart uses APIs that are deprecated or removed on Kubernetes 1.37"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "charts/app/Chart.yaml",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "partialFingerprints": {
            "helmbulance/v1": "df16ab1d9990773ffe36eea6fdeb23256b9a31c05c85a7abe8ebb31686ec2b8a"
          },
          "properties": {
            "scenario": "k8s-1.37",
            "severity": "medium",
            "evidence": [
              "batch/v1beta1 CronJob"
            ],
            "reproduce": []
          }
        },
        {
          "ruleId": "HB-K8S-004",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "The API server warns about objects this chart creates on Kubernetes 1.37"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "charts/app/Chart.yaml",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "partialFingerprints": {
            "helmbulance/v1": "3f877879b484e6ecaa2658b6331e52a3a3adfc46e67e3f3c7633d13683cb65a9"
          },
          "properties": {
            "scenario": "k8s-1.37",
            "severity": "low",
            "evidence": [],
            "reproduce": []
          }
        },
        {
          "ruleId": "HB-SCAN-003",
          "ruleIndex": 3,
          "level": "note",
          "message": {
            "text": "Candidate: Secret values are generated anew on every upgrade"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "charts/app/Chart.yaml",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "partialFingerprints": {
            "helmbulance/v1": "fec62c40a7b7420b5673766fabd78d2013276af9fe95e5ee6310d80bd36a6cba"
          },
          "properties": {
            "scenario": "scan",
            "severity": "candidate",
            "evidence": [],
            "reproduce": []
          }
        }
      ]
    }
  ]
}
